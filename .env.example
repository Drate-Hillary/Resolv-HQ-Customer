# Supabase project settings (Project Settings > API in the Supabase dashboard).
# Same project/values as resolv-hq's NEXT_PUBLIC_SUPABASE_URL / _PUBLISHABLE_KEY
# — both apps read and write the same database.
#
# Copy this file to .env.local (not .env.example — Expo never reads
# .env.example, it's just a template) and fill in the two values below.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# resolv-hq-backend base URL — every Postgres/Storage read and write goes
# through here now (see backend/api-client.ts). Auth stays direct to Supabase.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000


